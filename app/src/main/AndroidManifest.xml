<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Backups are off: chats are private and model files are gigabytes.
      allowBackup covers Android 11 and older; dataExtractionRules covers Android 12+
      (where allowBackup alone no longer stops device-to-device transfers).
      enableOnBackInvokedCallback turns on predictive back (Android 13+; older versions ignore
      it, hence tools:targetApi).
    -->
    <application
        android:name=".PocketMindApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:localeConfig="@xml/locales_config"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.PocketMind"
        tools:targetApi="33">

        <!-- singleTop: a widget/tile tap while the app is open is delivered to the running
             activity (onNewIntent) instead of stacking a second copy on top. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Share → PocketMind" for text (new chat, pre-filled) and PDFs (summarize). -->
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:label="@string/share_label_pdf">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!-- Home-screen widget (Glance). -->
        <receiver
            android:name=".widget.PocketMindWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pocketmind_widget_info" />
        </receiver>

        <!-- Quick-settings tile: only the system may bind to it (BIND_QUICK_SETTINGS_TILE). -->
        <service
            android:name=".widget.NewChatTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_chat"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- WorkManager normally starts itself at app launch with a default worker factory.
             We remove that so PocketMindApp can supply HiltWorkerFactory instead
             (Configuration.Provider). Without this, injected workers would crash. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
        <!--
          Privacy (owner's decision, 2026-11-03): Google Play Billing 9.1 brings Google's "datatransport"
          logging, whose CCT backend uploads device diagnostics (model, build fingerprint, carrier code,
          country, locale, time zone) from THIS app to Google. Removing the backend's registration means the
          uploader finds no backend and deletes queued events on the phone ("Unknown backend ... deleting
          event batch", checked in transport-runtime 3.1.8). Billing itself is unchanged.
        -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="backend:com.google.android.datatransport.cct.CctBackendFactory"
                tools:node="remove" />
        </service>
    </application>

</manifest>
