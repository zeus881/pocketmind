<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup rules. PocketMind backs up NOTHING:
  - chats (database) are private and must never leave the phone,
  - settings (datastore) may contain the custom system prompt,
  - model files are gigabytes and can be re-downloaded.
  "cloud-backup" = Google Drive backup; "device-transfer" = moving to a new phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
